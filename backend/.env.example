# --- Alpaca (Go SDK — used for execution only) ---
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca MCP server (used for read-only agent context) ---
# Note: the MCP server uses different env var names than the Go SDK.
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER_TRADE=True
# VERIFIED against alpaca-mcp-server source — do NOT add "trading" to
# this list. That toolset also auto-registers order-placement tools
# (place_stock_order etc.), which would break the human-in-the-loop
# guarantee. Position/order data instead comes from alpacaclient.go via
# the Go SDK directly. Full explanation in internal/mcpclient's doc
# comment. Real toolset names, confirmed from toolsets.py:
# account, trading, watchlists, assets, stock-data, crypto-data,
# options-data, corporate-actions, news, fixed-income-data, index-data,
# locates.
ALPACA_TOOLSETS=account,stock-data,options-data,news,assets

# Alpaca's market data API — same URL for paper and live (data access
# isn't split by paper/live the way trading is).
DATA_API_BASE_URL=https://data.alpaca.markets

# --- LLM (Fireworks AI, OpenAI-compatible endpoint) ---
FIREWORKS_API_KEY=your_fireworks_api_key
# REQUIRED — no default. Fireworks' serverless catalog rotates every
# few days (confirmed during development: the model that used to be
# here, llama-v3p1-70b-instruct, had already been retired and started
# 404ing). Get a CURRENT model ID from your own dashboard right before
# you set this, not from any example anywhere:
#   https://app.fireworks.ai/dashboard/serverless
# Pick any model tagged "Function-calling" (needed for structured JSON
# output — see internal/llm/fireworks.go's response_format usage).
# Format looks like: accounts/fireworks/models/<model-id>
# No default is set here on purpose — Fireworks' catalog rotates over
# time (confirmed during development: an earlier Llama 3.1 70B model
# used here stopped being available). Check the dashboard link above
# rather than trusting any specific name to still exist.
# Confirmed working as of Aug 2026: accounts/fireworks/models/kimi-k3
# (a reasoning model — internal/llm/fireworks.go sends
# reasoning_effort=none so its "thinking" tokens don't crowd out the
# JSON response this code needs to parse; see that file's comments).
FIREWORKS_MODEL=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# --- PocketBase ---
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change_me

# --- News (optional external headline source) ---
NEWS_API_KEY=your_news_api_key

# --- Agent behavior ---
WATCHLIST=AAPL,MSFT,NVDA,TSLA,SPY
AGENT_INTERVAL_MINUTES=15
EXECUTOR_POLL_SECONDS=10
MAX_POSITION_SIZE_USD=1000
DAILY_LOSS_LIMIT_USD=500
MACRO_EVENT_BUFFER_HOURS=2
